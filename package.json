{
  "name": "repopulse",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present run typecheck",
    "test": "node scripts/check-live-infra.mjs && vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx packages/shared/src/testing/seed/run.ts",
    "e2e": "playwright test",
    "e2e:demo": "playwright test -c playwright.demo.config.ts",
    "dev": "node scripts/dev.mjs",
    "bootstrap": "node scripts/setup.mjs",
    "check:bundle": "pnpm --filter @repopulse/web build && node scripts/check-bundle-size.mjs",
    "connect:forge": "tsx apps/api/src/cli/connect-forge.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1",
    "@repopulse/ingest": "workspace:^",
    "@repopulse/shared": "workspace:*",
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
