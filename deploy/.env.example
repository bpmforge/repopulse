# RepoPulse — customer install configuration (W11-01).
#
# YOU PROBABLY DO NOT NEED TO EDIT THIS BY HAND. Run:
#
#     deploy/configure.sh --url=https://repopulse.example.com
#
# It writes deploy/.env with every secret generated, the two connection URLs
# wired to the passwords it just made, and mode 0600 — and it needs no Node on
# this host (it runs inside the migrate image when Node is absent). Rerunning it
# NEVER rewrites an existing deploy/.env, because rotating TOKEN_ENC_KEY orphans
# every stored forge credential.
#
# This file is the reference for what each variable means, and the thing to edit
# afterwards. Never commit deploy/.env.

# --- data tier (internal only; not published to the host) ---
POSTGRES_USER=repopulse
POSTGRES_DB=repopulse
# Required. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Required. Generate: openssl rand -hex 24
REDIS_PASSWORD=

# These must match the credentials above — the app reaches the services by their
# compose service names on the internal network.
DATABASE_URL=postgres://repopulse:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/repopulse
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379

# --- where this install is reachable ---
# The URL your users open. Must match the GitHub App callback you register.
PUBLIC_BASE_URL=http://localhost:8099
API_BASE_URL=http://localhost:8099
REPOPULSE_PORT=8099
# Set to 0.0.0.0 only behind your own TLS terminator.
REPOPULSE_BIND=127.0.0.1

# --- secrets (generate your own; a shared value is a published value) ---
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 32 — decrypts stored forge credentials. Back it up
# separately from your database dump: losing it means every connected
# organisation must be re-authorised.
TOKEN_ENC_KEY=
# Must equal the webhook secret configured on your GitHub App.
WEBHOOK_SECRET=

# --- your forge app (see docs/INSTALL.md) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- optional: bring your own LLM ---
# Blank disables Tier-2. Tier-1 metrics need no LLM at all.
# The loaded model id to request, e.g. qwen3.8-27b. REQUIRED whenever
# LMSTUDIO_BASE_URLS is set: LM Studio rejects a request that does not name a
# model it has, and there is no safe default to guess.
LMSTUDIO_MODEL=
LMSTUDIO_BASE_URLS=
# Blank disables Tier-3. Presence still requires per-repo opt-in.
ANTHROPIC_API_KEY=

DATA_DIR=/app/.data
LOG_LEVEL=info
NODE_ENV=production

# --- Forge instance (W14-01) ---
# REQUIRED for a self-hosted forge. Gitea refuses to build a provider without
# it ("Gitea is self-hosted: FORGE_BASE_URL must point at the instance"), and
# GitHub Enterprise Server needs it too. Leave blank for github.com.
#
# NOTE: this is deployment-wide, not per-connection — every connection in this
# stack talks to this host. One deployment therefore serves ONE forge until
# W14-02 lands a per-connection base URL.
FORGE_BASE_URL=

# Scan data (W8-12). Blank means the deploy/scan-rules directory beside this
# file, which is what up.sh mounts and scan-db-sync.sh fills (W17-28). If you
# set it, it MUST BE ABSOLUTE: podman-compose does not resolve a relative bind
# source against this file's directory, and the worker then fails to start
# with a statfs error naming the container path. The directory must exist
# before `up`; deploy/scan-rules ships for exactly that reason.
SCAN_RULES_DIR=
# Scratch tmpfs for one snapshot at a time. Raise it for large monorepos rather
# than pointing the scratch root at a disk — the bytes are customer source.
SCAN_SCRATCH_SIZE=2g
# Shared secret between the worker and the scan-runner sidecar (W17-27), which
# is the one container holding the runtime socket. Generated by configure.mjs;
# any long random string. The runner refuses to start on TCP without one.
SCAN_RUNNER_TOKEN=

# PROVISION 5 GB OF DISK UNDER SCAN_RULES_DIR (W8-06). deploy/scan-db-sync.sh
# fetches grype's vulnerability database there: ~1.9 GiB at rest, and briefly
# double that, because a refresh stages the new copy beside the live one and
# swaps by rename — so a 4 GB volume does not fit a refresh. The sync checks
# free space and refuses to start rather than filling your disk.
#
# It is licensing, not size, that keeps this out of our image: the database
# aggregates 26 upstream feeds, each on its own terms, so your install fetches
# it directly instead of us redistributing it. CISA KEV and EPSS come with it —
# neither needs a feed of its own.
#
# Set to 0 to skip it. Do that knowing what it means: dependency scanning then
# finds nothing at all, and a repository with no findings looks exactly like a
# repository that is clean.
SCAN_SYNC_VULN_DB=1

# --- image and upstream selection (all have working defaults) -----------------
# Left blank here on purpose: the compose file's defaults are correct for a
# normal install, and a value in this file would silently override them. They
# are listed so `up` cannot surprise you with a knob you did not know existed.
#
# REPOPULSE_IMAGE_PREFIX  registry/namespace for the images   (default: repopulse;
#                         a bundle's install.sh pins localhost/repopulse)
# REPOPULSE_VERSION       image tag to run — SET THIS to roll back (default: dev;
#                         a bundle's install.sh pins its version, and up.sh
#                         refuses dev/latest when the images are pre-built)
# SCAN_IMAGE              sandbox image the scanners run in   (default: repopulse/scan:dev)
# API_UPSTREAM            host:port the web container proxies to (default: api:3000)
#
# scan-runner (W17-27) — up.sh derives all of these; set one only to override:
# SCAN_RUNTIME            podman | docker, the daemon behind the socket (default: the runtime running up.sh)
# CONTAINER_SOCKET        host path of that daemon's socket, mounted into scan-runner only
# SCAN_RUNNER_USER        uid:gid scan-runner runs as (default 0:0 = the rootless podman user; docker: 100:101)
# CONTAINER_SOCKET_GID    extra gid so that user can open the socket (docker: the docker group)

# --- the first administrator (D14) ---
# How you get in the first time. The account is created on the API's first boot
# and must change this password at first sign-in; delete ADMIN_PASSWORD once you
# have. Minimum 12 characters. Without these — and with no other local account —
# a fresh install has no way in at all.
ADMIN_EMAIL=
ADMIN_PASSWORD=
