# RepoPulse dev environment template — copy to .env (gitignored) and edit.
# Real .env is NEVER committed (CLAUDE.md Law 9). Values below are safe,
# obviously-insecure dev-only defaults matching compose.dev.yaml; regenerate
# every secret-shaped value before using outside a local dev machine.

# --- Data tier (matches compose.dev.yaml; loopback-only per SC-20) ---
DATABASE_URL=postgres://repopulse:repopulse_dev_password@localhost:5432/repopulse
REDIS_URL=redis://:repopulse_dev_password@localhost:6379

# --- GitHub auth (api: OAuth: worker: installation tokens) ---
# Dev (W0-05): set GITHUB_PAT to a fine-grained read-only PAT (contents,
# metadata, pull_requests, checks, deployments, issues) — sufficient to run
# the fixture recorder and the dev server against github.com. The local `gh`
# CLI token also works for one-time fixture recording (docs/research/
# github-app.md §1a). App-mode vars OR GITHUB_PAT are required; App mode is
# preferred in prod (FR-FORGE-5).
# Prod (W7-07): the GITHUB_APP_* set is populated once the production GitHub
# App is registered — that ticket is gated on the W7-05 deploy (its callback/
# webhook need repopulse.bpmforge.com live). Leave blank for dev.
GITHUB_PAT=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Auth / sessions / webhooks ---
# HMAC secret for X-Hub-Signature-256 (FR-INGEST-5). Dev-only value below —
# generate a real one with `openssl rand -hex 32` for anything else.
# `pnpm bootstrap` REPLACES this and SESSION_SECRET automatically: these values
# are published in this repository, so an install that kept them would sign
# sessions and validate webhook HMACs with a secret anyone can read.
WEBHOOK_SECRET=dev-insecure-webhook-secret-do-not-use-in-prod
# Cookie-signing secret; rotating it forces re-login. Dev-only value below.
SESSION_SECRET=dev-insecure-session-secret-do-not-use-in-prod
# AES-256-GCM key (32 bytes hex) for forge credentials at rest (FR-AUTH-5).
# DEPLOYMENT.md §3 calls this TOKEN_ENC_KEY — back it up separately from
# pg_dump; losing it means every stored forge credential must be re-entered.
# NOT pre-filled on purpose: a committed key is a published key, and this one
# decrypts every stored forge credential (Law 9 — nothing secret in git).
# Generate your own:  openssl rand -hex 32
TOKEN_ENC_KEY=

# --- LLM tiers (packages/analysis only — Law 8) ---
# Comma-separated LM Studio hosts on YOUR network; Tier-2 only. Blank disables
# Tier-2 — Tier-1 metrics need no LLM at all.
LMSTUDIO_BASE_URLS=
# Optional — absent disables Tier-3; presence still requires per-repo opt-in (NFR-9).
ANTHROPIC_API_KEY=

# --- App URLs ---
PUBLIC_BASE_URL=http://localhost:5173
# apps/api's own origin — OAuth redirect_uri and GitHub App callback both
# point here (not PUBLIC_BASE_URL, which is the SPA). Matches apps/api's
# default PORT (src/index.ts).
API_BASE_URL=http://localhost:3000

# --- Local storage ---
# Report/PDF artifacts and other local-disk state (docs/design/REPORTS.md §3).
DATA_DIR=./.data

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=development
