FROM debian:12.5
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates=20230311 curl=7.88.1-10+deb12u5 \
    && curl -fsSL https://example.com/tool.tar.gz | tar -xz -C /opt \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --no-log-init -m app
USER app
CMD ["/opt/tool/run"]
